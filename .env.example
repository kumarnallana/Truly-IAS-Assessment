DATABASE_URL="postgresql://user:password@your-neon-pooler-host/secureid?sslmode=require&connect_timeout=15&pool_timeout=15"
DIRECT_URL="postgresql://user:password@your-neon-direct-host/secureid?sslmode=require"
OTP_SECRET="replace-with-a-long-random-secret-at-least-32-bytes"
TOTP_ENCRYPTION_KEY="replace-with-a-32-byte-hex-key-for-aes-256-gcm"
JWT_SECRET="replace-with-an-independent-random-secret-at-least-32-bytes"
JWT_ISSUER="secureid"
JWT_AUDIENCE="secureid-api"
JWT_TTL_SECONDS=600
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
LOGIN_TRANSACTION_TTL_SECONDS=600
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
SESSION_TTL_SECONDS=28800
REMEMBER_SESSION_TTL_SECONDS=2592000
ENABLE_TEST_OTP=false
TEST_OTP_ACCESS_KEY="set-a-random-test-key-only-when-test-otp-is-enabled"
CLIENT_ORIGIN="http://localhost:4000"
COOKIE_SECURE=false
PORT=4000
